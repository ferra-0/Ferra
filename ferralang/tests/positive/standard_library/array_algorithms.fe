take "fe/array.fe"

fn main(): i64 {
  let values: i64[] = [4, 1, 3, 2]
  let reversed[4]: i64
  sort<i64>(values, 4)
  reverse<i64>(values, 4, reversed)

  if contains<i64>(3, values, 4) and indexof<i64>(3, values, 4) == 2 and
     values[0] == 1 and values[3] == 4 and
     reversed[0] == 4 and reversed[3] == 1 { ret 0 }
  ret 1
}
