// http
func native_http_get(
	receiver: ptr,
	rargs: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var args: Value[] = rargs

	if args[0].type not V_STRING {
		log("http.get expects string")
		value_write_null(out)
		ret 1
	}

	var g: str = http_get(args[0].text)
	value_write_str(out, g)
	free(g)
	ret 0
}
func native_http_post(
	receiver: ptr,
	rargs: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var args: Value[] = rargs

	if args[0].type not V_STRING or args[1].type not V_STRING {
		log("http.post expects strings")
		value_write_null(out)
		ret 1
	}

	var p: str = http_post(args[0].text, args[1].text)
	value_write_str(out, p)
	free(p) // value_write_str copies string. src needs to be freed
	ret 0
}
func native_http_stream(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var module: Module* = receiver
	var args: Value[] = raw_args
	if module is null or args[0].type not V_STRING {
		log("http.stream expects a URL string")
		ret 1
	}
	var handle: ptr = http_stream_open(args[0].text, "GET", null)
	if handle is null { log("http.stream allocation failed"); ret 1 }
	if eferra_write_stream(raw_out, module, EFERRA_STREAM_HTTP, handle) is false {
		http_stream_close(handle)
		log("http.stream allocation failed")
		ret 1
	}
	ret 0
}
func native_http_stream_post(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var module: Module* = receiver
	var args: Value[] = raw_args
	if module is null or args[0].type not V_STRING or
			args[1].type not V_STRING {
		log("http.stream_post expects URL and body strings")
		ret 1
	}
	var handle: ptr = http_stream_open(args[0].text, "POST", args[1].text)
	if handle is null { log("http.stream_post allocation failed"); ret 1 }
	if eferra_write_stream(raw_out, module, EFERRA_STREAM_HTTP, handle) is false {
		http_stream_close(handle)
		log("http.stream_post allocation failed")
		ret 1
	}
	ret 0
}
func register_http(module: Module*) {
	var http_type: i32 = (module^).find_native_type("Http")
	if http_type < 0 { http_type = (module^).add_native_type("Http") }

	if (module^).find_native_method(http_type, "get") < 0 {
		(module^).add_native_method(http_type, "get", 1, native_http_get)
	}
	if (module^).find_native_method(http_type, "post") < 0 {
		(module^).add_native_method(http_type, "post", 2, native_http_post)
	}
	if (module^).find_native_method(http_type, "stream") < 0 {
		(module^).add_native_method(http_type, "stream", 1, native_http_stream)
	}
	if (module^).find_native_method(http_type, "stream_post") < 0 {
		(module^).add_native_method(
			http_type,
			"stream_post",
			2,
			native_http_stream_post
		)
	}

	if (module^).find_native_global("http") < 0 {
		var http_value: Value
		value_write_native_object(^http_value, http_type, module)
		(module^).add_native_global("http", http_value)
	}
}

// threads
stct EFerraThreadTask {
	thread_handle: ptr,
	active: bol,
	module: Module*,
	function_id: i32,
	args: Value[],
	argument_count: i32,
	done: i32
}

func eferra_thread_release_args(task: EFerraThreadTask*) {
	if task.args not null {
		for i in task.argument_count { dropnow task.args[i] }
		free(task.args)
		task.args = null
		task.argument_count = 0
	}
}
func eferra_thread_entry(raw_task: ptr): ptr {
	var task: EFerraThreadTask* = raw_task
	var vm: VM()
	vm.field_cache_enabled = false
	var result: Value
	value_write_null(^result)
	vm_execute(
		^vm,
		task.module,
		task.function_id,
		task.args,
		task.argument_count,
		^result
	)
	dropnow result
	eferra_thread_release_args(task)
	atomic_store<i32>(^(task.done), 1)
	ret null
}
func eferra_thread_task_drop(raw_task: ptr): i32 {
	var task: EFerraThreadTask* = raw_task
	if task is null { ret 0 }
	if task.active {
		ferra_thread_join(task.thread_handle)
		task.thread_handle = null
		task.active = false
	}
	eferra_thread_release_args(task)
	free(task)
	ret 0
}
func native_thread_create(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var module: Module* = receiver
	var args: Value[] = raw_args
	var out: Value* = raw_out
	if module is null {
		log("thread.create: invalid module")
		ret 1
	}
	if args[0].type not V_FUNCTION {
		log("thread.create expects an eFerra function as argument 1")
		ret 1
	}
	if args[1].type not V_ARRAY {
		log("thread.create expects an array as argument 2")
		ret 1
	}

	var function_id: i32 = args[0].native_id
	if function_id < 0 or function_id >= (module^).function_count {
		log("thread.create received an invalid function")
		ret 1
	}
	var count: i32 = value_array_size(args[1])
	var function: Function* = ^((module^).functions[function_id])
	if count not function.parameter_count {
		logl("thread.create: argument array does not match function ")
		log(function.name)
		ret 1
	}

	var task: EFerraThreadTask* = calloc(1, sizeof(EFerraThreadTask))
	if task is null {
		log("thread.create: allocation failed")
		ret 1
	}
	task.module = module
	task.function_id = function_id
	task.argument_count = count
	atomic_store<i32>(^(task.done), 0)

	if count > 0 {
		var copied_args: Value[] = calloc(count, sizeof(Value))
		if copied_args is null {
			free(task)
			log("thread.create: argument allocation failed")
			ret 1
		}
		task.args = copied_args
		var source: Value[] = value_array_items(args[1])
		for i in count { value_clone_into(source[i], ^(task.args[i])) }
	}

	var thread_handle: ptr = null
	if ferra_thread_create(^thread_handle, eferra_thread_entry, task) not 0 {
		eferra_thread_release_args(task)
		free(task)
		log("thread.create: native thread creation failed")
		ret 1
	}
	task.thread_handle = thread_handle
	task.active = true

	value_write_owned_native_object(
		out,
		(module^).thread_handle_native_type,
		task,
		eferra_thread_task_drop
	)
	ret 0
}
func native_thread_join(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var task: EFerraThreadTask* = receiver
	if task is null { log("Thread.join: invalid thread"); ret 1 }
	if task.active {
		if ferra_thread_join(task.thread_handle) not 0 {
			log("Thread.join: native thread join failed")
			ret 1
		}
		task.thread_handle = null
		task.active = false
	}
	value_write_null(raw_out)
	ret 0
}
func native_thread_done(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var task: EFerraThreadTask* = receiver
	if task is null { log("Thread.done: invalid thread"); ret 1 }
	value_write_num(raw_out, atomic_load<i32>(^(task.done)) as f64)
	ret 0
}
func register_thread_handle(module: Module*) {
	var handle_type: i32 = (module^).add_native_type("Thread")
	(module^).thread_handle_native_type = handle_type
	(module^).add_native_method(handle_type, "join", 0, native_thread_join)
	(module^).add_native_method(handle_type, "done", 0, native_thread_done)
}
func register_thread(module: Module*) {
	register_thread_handle(module)
	var runtime_type: i32 = (module^).add_native_type("ThreadRuntime")
	(module^).add_native_method(runtime_type, "create", 2, native_thread_create)

	var thread_value: Value
	value_write_native_object(^thread_value, runtime_type, module)
	(module^).add_native_global("thread", thread_value)
}

// sys
func native_sys_args(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	if _argc <= 1 {
		value_write_null(out)
		ret 0
	}

	var vals: Value[] = malloc(sizeof(Value)*_argc)
	if vals is null {
		log("failed to allocate values for args")
		value_write_null(out)
		ret 0
	}

	var need: i64 = _argc-1
	for i in need {
		value_write_str(^(vals[i]), strdup(_args[i+1]))
	}

	value_write_array(out, vals, need)

	ret 0
}
func native_sys_cmd(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var args: Value[] = raw_args

	if args[0].type not V_STRING {
		log("sys.cmd expects string")
		value_write_null(out)
		ret 1
	}

	value_write_num(out, system(args[0].text))

	ret 0
}
func native_sys_cmdout(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var args: Value[] = raw_args

	if args[0].type not V_STRING or args[1].type not V_STRING {
		log("sys.cmd expects strings")
		value_write_null(out)
		ret 1
	}

	var p: Process(args[0].text)
	p.arg(args[1].text)
	var process_output: u8[] = p.output()
	if process_output is null {
		log("sys.cmdout failed to start the process")
		value_write_null(out)
		ret 1
	}

	value_write_str(out, strdup(process_output as str))

	ret 0
}
func native_sys_exit(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var args: Value[] = raw_args

	if args[0].type not V_NUM {
		log("sys.exit expects num")
		value_write_null(out)
		ret 1
	}

	exit(args[0].num)

	ret 0
}
func native_sys_platform(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	value_write_str(out, platform())

	ret 0
}
func register_sys(module: Module*) {
	var sys_type: i32 = (module^).find_native_type("Sys")
	if sys_type < 0 { sys_type = (module^).add_native_type("Sys") }

	if (module^).find_native_method(sys_type, "args") < 0 {
		(module^).add_native_method(sys_type, "args", 0, native_sys_args)
	}
	if (module^).find_native_method(sys_type, "cmd") < 0 {
		(module^).add_native_method(sys_type, "cmd", 1, native_sys_cmd)
	}
	if (module^).find_native_method(sys_type, "cmdout") < 0 {
		(module^).add_native_method(sys_type, "cmdout", 2, native_sys_cmdout)
	}
	if (module^).find_native_method(sys_type, "exit") < 0 {
		(module^).add_native_method(sys_type, "exit", 1, native_sys_exit)
	}
	if (module^).find_native_method(sys_type, "platform") < 0 {
		(module^).add_native_method(sys_type, "platform", 0, native_sys_platform)
	}

	if (module^).find_native_global("sys") < 0 {
		var sys_value: Value
		value_write_native_object(^sys_value, sys_type, module)
		(module^).add_native_global("sys", sys_value)
	}
}

// string, array, object
func primitive_receiver(raw: ptr, expected: i8, method: str): Value* {
	var receiver: Value* = raw
	if receiver is null or receiver.type not expected {
		logl("runtime error: invalid receiver for ")
		log(method)
		ret null
	}
	ret receiver
}

func native_string_len(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_STRING, "String.len")
	if receiver is null { ret 1 }
	value_write_num(raw_out, strlen(receiver.text) as f64)
	ret 0
}
func primitive_string_matches(text: str, at: i32, needle: str, needle_size: i32): bol {
	for i in needle_size {
		if text[at + i] not needle[i] { ret false }
	}
	ret true
}
func native_string_contains(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_STRING, "String.contains")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING {
		log("String.contains expects a string")
		ret 1
	}
	var text_size: i32 = strlen(receiver.text) as i32
	var needle_size: i32 = strlen(args[0].text) as i32
	if needle_size is 0 { value_write_num(raw_out, 1); ret 0 }
	if needle_size <= text_size {
		for i in text_size - needle_size + 1 {
			if primitive_string_matches(receiver.text, i, args[0].text, needle_size) {
				value_write_num(raw_out, 1)
				ret 0
			}
		}
	}
	value_write_num(raw_out, 0)
	ret 0
}
func native_string_starts_with(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_STRING, "String.starts_with")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING {
		log("String.starts_with expects a string")
		ret 1
	}
	var text_size: i32 = strlen(receiver.text) as i32
	var needle_size: i32 = strlen(args[0].text) as i32
	var matches: bol = needle_size <= text_size and
		primitive_string_matches(receiver.text, 0, args[0].text, needle_size)
	value_write_num(raw_out, matches as f64)
	ret 0
}
func native_string_ends_with(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_STRING, "String.ends_with")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING {
		log("String.ends_with expects a string")
		ret 1
	}
	var text_size: i32 = strlen(receiver.text) as i32
	var needle_size: i32 = strlen(args[0].text) as i32
	var matches: bol = needle_size <= text_size and primitive_string_matches(
		receiver.text,
		text_size - needle_size,
		args[0].text,
		needle_size
	)
	value_write_num(raw_out, matches as f64)
	ret 0
}
func primitive_write_substring(out: Value*, text: str, start: i32, size: i32): bol {
	var copy: str = calloc(size + 1, 1)
	if copy is null { ret false }
	if size > 0 { memcpy(copy, text + start, size) }
	value_write_str(out, copy)
	free(copy)
	ret true
}
func native_string_split(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_STRING, "String.split")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING or strlen(args[0].text) is 0 {
		log("String.split expects a non-empty string separator")
		ret 1
	}
	var text_size: i32 = strlen(receiver.text) as i32
	var separator_size: i32 = strlen(args[0].text) as i32
	var items: Value[] = calloc(text_size + 1, sizeof(Value))
	if items is null { log("String.split allocation failed"); ret 1 }
	var item_count: i32 = 0
	var start: i32 = 0
	var cursor: i32 = 0
	for cursor <= text_size {
		var found: bol = cursor + separator_size <= text_size and
			primitive_string_matches(receiver.text, cursor, args[0].text, separator_size)
		if found or cursor is text_size {
			if primitive_write_substring(^(items[item_count]), receiver.text, start, cursor - start) is false {
				for i in item_count { dropnow items[i] }
				free(items)
				ret 1
			}
			item_count += 1
			if cursor is text_size { stop }
			cursor += separator_size
			start = cursor
		} else {
			cursor += 1
		}
	}
	value_write_array(raw_out, items, item_count)
	ret 0
}

func native_array_len(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_ARRAY, "Array.len")
	if receiver is null { ret 1 }
	value_write_num(raw_out, value_array_size(receiver^) as f64)
	ret 0
}
func native_array_push(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_ARRAY, "Array.push")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if value_array_push(receiver, args[0]) is false {
		log("Array.push allocation failed")
		ret 1
	}
	value_write_num(raw_out, value_array_size(receiver^) as f64)
	ret 0
}
func native_array_pop(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_ARRAY, "Array.pop")
	if receiver is null { ret 1 }
	value_write_null(raw_out)
	value_array_pop(receiver, raw_out)
	ret 0
}
func native_array_first(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_ARRAY, "Array.first")
	if receiver is null { ret 1 }
	var size: i32 = value_array_size(receiver^)
	if size is 0 { value_write_null(raw_out); ret 0 }
	var items: Value[] = value_array_items(receiver^)
	value_assign(raw_out, items[0])
	ret 0
}
func native_array_last(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_ARRAY, "Array.last")
	if receiver is null { ret 1 }
	var size: i32 = value_array_size(receiver^)
	if size is 0 { value_write_null(raw_out); ret 0 }
	var items: Value[] = value_array_items(receiver^)
	value_assign(raw_out, items[size - 1])
	ret 0
}
func native_array_contains(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_ARRAY, "Array.contains")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	var size: i32 = value_array_size(receiver^)
	var items: Value[] = value_array_items(receiver^)
	for i in size {
		if value_equal(items[i], args[0]) {
			value_write_num(raw_out, 1)
			ret 0
		}
	}
	value_write_num(raw_out, 0)
	ret 0
}
func primitive_append_value(out: String, value: Value): bol {
	if value.type is V_NULL { out.append("null"); ret true }
	if value.type is V_STRING { out.append(value.text); ret true }
	if value.type is V_NUM {
		var buffer: str = calloc(64, 1)
		if buffer is null { ret false }
		snprintf(buffer, 64, "%g", value.num)
		out.append(buffer)
		free(buffer)
		ret true
	}
	if value.type is V_ARRAY or value.type is V_OBJECT {
		var encoded: Json()
		if value_to_json(value, encoded) is false { ret false }
		out.append(encoded.dump())
		ret true
	}
	ret false
}
func native_array_join(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_ARRAY, "Array.join")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING { log("Array.join expects a string"); ret 1 }
	var result: String()
	var size: i32 = value_array_size(receiver^)
	var items: Value[] = value_array_items(receiver^)
	for i in size {
		if i > 0 { result.append(args[0].text) }
		if primitive_append_value(result, items[i]) is false {
			log("Array.join cannot format native values")
			ret 1
		}
	}
	value_write_str(raw_out, result.cstr())
	ret 0
}

func native_object_len(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_OBJECT, "Object.len")
	if receiver is null { ret 1 }
	value_write_num(raw_out, value_object_size(receiver^) as f64)
	ret 0
}
func native_object_has(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_OBJECT, "Object.has")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING { log("Object.has expects a string"); ret 1 }
	value_write_num(raw_out, (value_object_find(receiver^, args[0].text) >= 0) as f64)
	ret 0
}
func native_object_get(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_OBJECT, "Object.get")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING { log("Object.get expects a string"); ret 1 }
	var index: i32 = value_object_find(receiver^, args[0].text)
	if index < 0 { value_write_null(raw_out); ret 0 }
	var items: Value[] = value_object_items(receiver^)
	value_assign(raw_out, items[index])
	ret 0
}
func native_object_set(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_OBJECT, "Object.set")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING { log("Object.set expects a string key"); ret 1 }
	value_object_set(receiver, args[0].text, args[1])
	value_write_num(raw_out, 1)
	ret 0
}
func native_object_remove(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_OBJECT, "Object.remove")
	var args: Value[] = raw_args
	if receiver is null { ret 1 }
	if args[0].type not V_STRING { log("Object.remove expects a string"); ret 1 }
	value_write_null(raw_out)
	value_object_remove(receiver, args[0].text, raw_out)
	ret 0
}
func native_object_keys(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_OBJECT, "Object.keys")
	if receiver is null { ret 1 }
	var size: i32 = value_object_size(receiver^)
	var values: Value[] = null
	if size > 0 { values = calloc(size, sizeof(Value)) }
	if size > 0 and values is null { ret 1 }
	var keys: str[] = (receiver.refs^).object_keys
	for i in size { value_write_str(^(values[i]), keys[i]) }
	value_write_array(raw_out, values, size)
	ret 0
}
func native_object_values(receiver_raw: ptr, raw_args: ptr, count: i32, raw_out: ptr): i32 {
	var receiver: Value* = primitive_receiver(receiver_raw, V_OBJECT, "Object.values")
	if receiver is null { ret 1 }
	var size: i32 = value_object_size(receiver^)
	var values: Value[] = null
	if size > 0 { values = calloc(size, sizeof(Value)) }
	if size > 0 and values is null { ret 1 }
	var items: Value[] = value_object_items(receiver^)
	for i in size { value_clone_into(items[i], ^(values[i])) }
	value_write_array(raw_out, values, size)
	ret 0
}

func register_primitive_methods(module: Module*) {
	var string_type: i32 = (module^).add_native_type("String")
	(module^).string_native_type = string_type
	(module^).add_native_method(string_type, "len", 0, native_string_len)
	(module^).add_native_method(string_type, "contains", 1, native_string_contains)
	(module^).add_native_method(string_type, "starts_with", 1, native_string_starts_with)
	(module^).add_native_method(string_type, "ends_with", 1, native_string_ends_with)
	(module^).add_native_method(string_type, "split", 1, native_string_split)

	var array_type: i32 = (module^).add_native_type("Array")
	(module^).array_native_type = array_type
	(module^).add_native_method(array_type, "len", 0, native_array_len)
	(module^).add_native_method(array_type, "push", 1, native_array_push)
	(module^).add_native_method(array_type, "pop", 0, native_array_pop)
	(module^).add_native_method(array_type, "first", 0, native_array_first)
	(module^).add_native_method(array_type, "last", 0, native_array_last)
	(module^).add_native_method(array_type, "contains", 1, native_array_contains)
	(module^).add_native_method(array_type, "join", 1, native_array_join)

	var object_type: i32 = (module^).add_native_type("Object")
	(module^).object_native_type = object_type
	(module^).add_native_method(object_type, "len", 0, native_object_len)
	(module^).add_native_method(object_type, "has", 1, native_object_has)
	(module^).add_native_method(object_type, "get", 1, native_object_get)
	(module^).add_native_method(object_type, "set", 2, native_object_set)
	(module^).add_native_method(object_type, "remove", 1, native_object_remove)
	(module^).add_native_method(object_type, "keys", 0, native_object_keys)
	(module^).add_native_method(object_type, "values", 0, native_object_values)
}

func register_standard_natives(module: Module*) {
	if (module^).standard_natives_registered is false {
		(module^).standard_natives_registered = true

		register_primitive_methods(module)
		
		register_thread(module)
		register_buffer_and_stream(module)
		register_timer(module)
		register_json(module)
		register_file(module)
		register_math(module)
		register_http(module)
		register_sys(module)
	}
}
