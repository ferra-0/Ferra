	if math_type < 0 { math_type = (module^).add_native_type("Math") }

	if (module^).find_native_method(math_type, "sin") < 0 {
		(module^).add_native_method(math_type, "sin", 1, native_math_sin)
	}
	if (module^).find_native_method(math_type, "cos") < 0 {
		(module^).add_native_method(math_type, "cos", 1, native_math_cos)
