ftake "./value.fe"
ftake "./function.fe"
ftake "./compiler.fe"

take "fe/timer.fe"
take "fe/json.fe"
take "fe/file.fe"
take "fe/math.fe"
take "fe/http.fe"
take "fe/env.fe"
take "fe/thread.fe"
take "fe/process.fe"
take "fe/dirit.fe"

extern func efe_native_call_bridge(ptr, ptr, ptr, i32, ptr): i32
extern func system(str): i32

// timer
func native_timer_start(
	receiver: ptr,
	args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	timer.start()
	var result: Value* = out
	value_write_null(result)
	ret 0
}
func native_timer_s(
	receiver: ptr,
	args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var result: Value* = out
	value_write_num(result, timer.s() as f64)
	ret 0
}
func native_timer_ms(
	receiver: ptr,
	args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var result: Value* = out
	value_write_num(result, timer.ms() as f64)
	ret 0
}
func native_timer_ns(
	receiver: ptr,
	args: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var result: Value* = out
	value_write_num(result, timer.ns() as f64)
	ret 0
}
func register_timer(module: Module*) {
	var timer_type: i32 = (module^).find_native_type("Timer")
	if timer_type < 0 { timer_type = (module^).add_native_type("Timer") }
	if (module^).find_native_method(timer_type, "start") < 0 {
		(module^).add_native_method(timer_type, "start", 0, native_timer_start)
	}
	if (module^).find_native_method(timer_type, "s") < 0 {
		(module^).add_native_method(timer_type, "s", 0, native_timer_s)
	}
	if (module^).find_native_method(timer_type, "ms") < 0 {
		(module^).add_native_method(timer_type, "ms", 0, native_timer_ms)
	}
	if (module^).find_native_method(timer_type, "ns") < 0 {
		(module^).add_native_method(timer_type, "ns", 0, native_timer_ns)
	}

	if (module^).find_native_global("timer") < 0 {
		var timer_value: Value
		value_write_native_object(^timer_value, timer_type, null)
		(module^).add_native_global("timer", timer_value)
	}
}

// json
func value_to_json(v: Value, out: Json): bol {
	if v.type is V_NULL { ret out.makenull() }
	if v.type is V_NUM { ret out.fromnum(v.num) }
	if v.type is V_STRING { ret out.fromstr(v.text) }

	if v.type is V_ARRAY {
		if out.makearr() is false { ret false }
		var size: i32 = value_array_size(v)
		var items: Value[] = value_array_items(v)
		for i in size {
			var item: Json()
			if value_to_json(items[i], item) is false { ret false }
			if out.pushjson(item) is false { ret false }
		}
		ret true
	}

	if v.type is V_OBJECT {
		if out.makeobj() is false { ret false }
		var size: i32 = value_object_size(v)
		var keys: str[] = (v.refs^).object_keys
		var items: Value[] = (v.refs^).object_items
		for i in size {
			var item: Json()
			if value_to_json(items[i], item) is false { ret false }
			if out.setjson(keys[i], item) is false { ret false }
		}
		ret true
	}

	ret false
}
func json_to_value(j: Json, out: Value*): bol {
	if j.isnull() {
		value_write_null(out)
		ret true
	}
	if j.isbol() {
		value_write_num(out, j.asbol() as f64)
		ret true
	}
	if j.isnum() {
		value_write_num(out, j.asnum())
		ret true
	}
	if j.isstr() {
		value_write_str(out, j.asstr())
		ret true
	}

	if j.isarr() {
		var size: i32 = j.size() as i32
		var items: Value[] = null
		if size > 0 {
			items = calloc(size, sizeof(Value))
			if items is null { ret false }
		}
		value_write_array(out, items, size)
		for i in size {
			var item: Json()
			item.handle = json_at(j.handle, i)
			item.owned = item.handle not null
			if item.handle is null or
					json_to_value(item, ^(items[i])) is false {
				value_release(out)
				ret false
			}
		}
		ret true
	}

	if j.isobj() {
		var size: i32 = j.size() as i32
		var keys: str[] = null
		var items: Value[] = null
		if size > 0 {
			keys = calloc(size, sizeof(str))
			items = calloc(size, sizeof(Value))
			if keys is null or items is null {
				if keys not null { free(keys) }
				if items not null { free(items) }
				ret false
			}
		}
		value_write_object(out, keys, items, size)
		for i in size {
			var key: str = j.key(i)
			if key is null {
				value_release(out)
				ret false
			}
			keys[i] = strclone(key)
			// Keep the eFerra runtime independent of the public Json.get API:
			// projects can use either its legacy out-parameter form or the
			// newer tuple-returning form without preventing the VM from building.
			var item: Json()
			item.handle = json_get(j.handle, key)
			item.owned = item.handle not null
			if item.handle is null or
					json_to_value(item, ^(items[i])) is false {
				value_release(out)
				ret false
			}
		}
		ret true
	}

	ret false
}
func native_json_parse(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var args: Value[] = raw_args
	var out: Value* = raw_out
	if args[0].type not V_STRING {
		log("json.parse expects a string")
		ret 1
	}

	var parsed: Json()
	if parsed.parse(args[0].text) is false {
		log("json.parse received invalid JSON")
		ret 1
	}
	if json_to_value(parsed, out) is false {
		log("json.parse could not convert the JSON value")
		ret 1
	}
	ret 0
}
func native_json_stringify(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var args: Value[] = raw_args
	var out: Value* = raw_out
	var encoded: Json()
	if value_to_json(args[0], encoded) is false {
		log("json.stringify cannot encode native functions or objects")
		ret 1
	}

	var text: str = encoded.dump()
	if text is null {
		log("json.stringify failed")
		ret 1
	}
	value_write_str(out, text)
	ret 0
}
func register_json(module: Module*) {
	var json_type: i32 = (module^).find_native_type("Json")
	if json_type < 0 { json_type = (module^).add_native_type("Json") }
	if (module^).find_native_method(json_type, "parse") < 0 {
		(module^).add_native_method(json_type, "parse", 1, native_json_parse)
	}
	if (module^).find_native_method(json_type, "stringify") < 0 {
		(module^).add_native_method(
			json_type,
			"stringify",
			1,
			native_json_stringify
		)
	}

	if (module^).find_native_global("json") < 0 {
		var json_value: Value
		value_write_native_object(^json_value, json_type, null)
		(module^).add_native_global("json", json_value)
	}
}

// buffer and streams
const EFERRA_STREAM_FILE: i32 = 1
const EFERRA_STREAM_HTTP: i32 = 2

stct EFerraBuffer {
	data: ptr,
	size: i64,
	capacity: i64,
	native_type: i32
}

stct EFerraStream {
	kind: i32,
	handle: ptr,
	closed: bol,
	done: bol,
	read_error: bol,
	buffer_native_type: i32
}

func eferra_buffer_drop(raw_buffer: ptr): i32 {
	var buffer: EFerraBuffer* = raw_buffer
	if buffer is null { ret 0 }
	if buffer.data not null { free(buffer.data) }
	free(buffer)
	ret 0
}
func eferra_buffer_reserve(buffer: EFerraBuffer*, requested: i64): bol {
	if buffer is null or requested < 0 or requested > 9223372036854775806 {
		ret false
	}
	if requested <= buffer.capacity { ret true }
	var grown_capacity: i64 = buffer.capacity
	if grown_capacity < 1 { grown_capacity = 1 }
	for grown_capacity < requested {
		if grown_capacity > 4611686018427387903 {
			grown_capacity = requested
		} else {
			grown_capacity += grown_capacity
		}
	}
	var grown: ptr = malloc(grown_capacity + 1)
	if grown is null { ret false }
	if buffer.data not null and buffer.size > 0 {
		memcpy(grown, buffer.data, buffer.size)
	}
	if buffer.data not null { free(buffer.data) }
	buffer.data = grown
	buffer.capacity = grown_capacity
	var bytes: u8[] = buffer.data
	bytes[buffer.size] = 0
	ret true
}
func eferra_buffer_append_raw(buffer: EFerraBuffer*, source: ptr, count: i64): bol {
	if buffer is null or count < 0 { ret false }
	if count is 0 { ret true }
	var requested: i64 = buffer.size + count
	if requested < buffer.size { ret false }
	if eferra_buffer_reserve(buffer, requested) is false { ret false }
	memcpy(buffer.data + buffer.size, source, count)
	buffer.size = requested
	var bytes: u8[] = buffer.data
	bytes[buffer.size] = 0
	ret true
}
func native_buffer_create(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var module: Module* = receiver
	var args: Value[] = raw_args
	if module is null or args[0].type not V_NUM {
		log("buffer.create expects a positive integer capacity")
		ret 1
	}
	if args[0].num < 1 or args[0].num > 9007199254740991.0 {
		log("buffer.create expects a positive integer capacity")
		ret 1
	}
	var capacity: i64 = args[0].num as i64
	if capacity <= 0 or (capacity as f64) not args[0].num {
		log("buffer.create expects a positive integer capacity")
		ret 1
	}
	var buffer: EFerraBuffer* = calloc(1, sizeof(EFerraBuffer))
	if buffer is null { log("buffer.create allocation failed"); ret 1 }
	buffer.data = calloc(capacity + 1, 1)
	if buffer.data is null { free(buffer); log("buffer.create allocation failed"); ret 1 }
	buffer.capacity = capacity
	buffer.native_type = (module^).buffer_native_type
	value_write_owned_native_object(
		raw_out,
		(module^).buffer_native_type,
		buffer,
		eferra_buffer_drop
	)
	ret 0
}
func native_buffer_from(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var module: Module* = receiver
	var args: Value[] = raw_args
	if module is null or args[0].type not V_STRING {
		log("buffer.from expects a string")
		ret 1
	}
	var size: i64 = strlen(args[0].text) as i64
	var capacity: i64 = size
	if capacity < 1 { capacity = 1 }
	var create_arg: Value
	value_write_num(^create_arg, capacity as f64)
	if native_buffer_create(module, ^create_arg, 1, raw_out) not 0 { ret 1 }
	var out: Value* = raw_out
	var buffer: EFerraBuffer* = out.native_data
	if size > 0 and eferra_buffer_append_raw(buffer, args[0].text, size) is false {
		value_release(out)
		log("buffer.from allocation failed")
		ret 1
	}
	ret 0
}
func native_buffer_len(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var buffer: EFerraBuffer* = receiver
	if buffer is null { ret 1 }
	value_write_num(out, buffer.size as f64)
	ret 0
}
func native_buffer_capacity(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var buffer: EFerraBuffer* = receiver
	if buffer is null { ret 1 }
	value_write_num(out, buffer.capacity as f64)
	ret 0
}
func native_buffer_clear(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var buffer: EFerraBuffer* = receiver
	if buffer is null { ret 1 }
	buffer.size = 0
	var bytes: u8[] = buffer.data
	bytes[0] = 0
	value_write_null(out)
	ret 0
}
func native_buffer_reserve(
	receiver: ptr,
	raw_args: ptr,
	count: i32,
	raw_out: ptr
): i32 {
	var buffer: EFerraBuffer* = receiver
	var args: Value[] = raw_args
	if buffer is null or args[0].type not V_NUM {
		log("Buffer.reserve expects a non-negative integer")
		ret 1
	}
	if args[0].num < 0 or args[0].num > 9007199254740991.0 {
		log("Buffer.reserve expects a non-negative integer")
		ret 1
	}
	var requested: i64 = args[0].num as i64
	if requested < 0 or (requested as f64) not args[0].num or
			eferra_buffer_reserve(buffer, requested) is false {
		log("Buffer.reserve failed")
		ret 1
	}
	value_write_num(raw_out, buffer.capacity as f64)
	ret 0
}
func native_buffer_append(
	receiver: ptr,
	raw_args: ptr,
	count: i32,
	raw_out: ptr
): i32 {
	var buffer: EFerraBuffer* = receiver
	var args: Value[] = raw_args
	if buffer is null { ret 1 }
	if args[0].type is V_STRING {
		if eferra_buffer_append_raw(
			buffer,
			args[0].text,
			strlen(args[0].text) as i64
		) is false { log("Buffer.append allocation failed"); ret 1 }
	} elif args[0].type is V_NUM {
		if args[0].num < 0 or args[0].num > 255 {
			log("Buffer.append byte must be an integer from 0 to 255")
			ret 1
		}
		var byte: i64 = args[0].num as i64
		if (byte as f64) not args[0].num {
			log("Buffer.append byte must be an integer from 0 to 255")
			ret 1
		}
		if eferra_buffer_reserve(buffer, buffer.size + 1) is false {
			log("Buffer.append allocation failed")
			ret 1
		}
		var bytes: u8[] = buffer.data
		bytes[buffer.size] = byte as u8
		buffer.size += 1
		bytes[buffer.size] = 0
	} elif args[0].type is V_NATIVE_OBJECT and
			args[0].native_id is buffer.native_type {
		var source: EFerraBuffer* = args[0].native_data
		var source_size: i64 = source.size
		if eferra_buffer_reserve(buffer, buffer.size + source_size) is false {
			log("Buffer.append allocation failed")
			ret 1
		}
		if eferra_buffer_append_raw(buffer, source.data, source_size) is false {
			log("Buffer.append allocation failed")
			ret 1
		}
	} else {
		log("Buffer.append expects a string, byte, or Buffer")
		ret 1
	}
	value_write_num(raw_out, buffer.size as f64)
	ret 0
}
func native_buffer_str(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var buffer: EFerraBuffer* = receiver
	if buffer is null { ret 1 }
	value_write_str(out, buffer.data as str)
	ret 0
}
func native_buffer_bytes(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var buffer: EFerraBuffer* = receiver
	if buffer is null { ret 1 }
	if buffer.size > 2147483647 {
		log("Buffer.bytes cannot create an array larger than i32")
		ret 1
	}
	var values: Value[] = null
	if buffer.size > 0 { values = calloc(buffer.size, sizeof(Value)) }
	if buffer.size > 0 and values is null { ret 1 }
	var bytes: u8[] = buffer.data
	for i in buffer.size { value_write_num(^(values[i]), bytes[i] as f64) }
	value_write_array(out, values, buffer.size as i32)
	ret 0
}
func native_buffer_get(receiver: ptr, raw_args: ptr, count: i32, out: ptr): i32 {
	var buffer: EFerraBuffer* = receiver
	var args: Value[] = raw_args
	if buffer is null or args[0].type not V_NUM { log("Buffer.get expects an index"); ret 1 }
	if args[0].num < 0 or args[0].num > 9007199254740991.0 {
		log("Buffer.get index out of bounds")
		ret 1
	}
	var index: i64 = args[0].num as i64
	if index < 0 or index >= buffer.size or (index as f64) not args[0].num {
		log("Buffer.get index out of bounds")
		ret 1
	}
	var bytes: u8[] = buffer.data
	value_write_num(out, bytes[index] as f64)
	ret 0
}
func native_buffer_set(receiver: ptr, raw_args: ptr, count: i32, out: ptr): i32 {
	var buffer: EFerraBuffer* = receiver
	var args: Value[] = raw_args
	if buffer is null or args[0].type not V_NUM or args[1].type not V_NUM {
		log("Buffer.set expects index and byte")
		ret 1
	}
	if args[0].num < 0 or args[0].num > 9007199254740991.0 or
			args[1].num < 0 or args[1].num > 255 {
		log("Buffer.set index or byte out of bounds")
		ret 1
	}
	var index: i64 = args[0].num as i64
	var byte: i64 = args[1].num as i64
	if index < 0 or index >= buffer.size or (index as f64) not args[0].num or
			byte < 0 or byte > 255 or (byte as f64) not args[1].num {
		log("Buffer.set index or byte out of bounds")
		ret 1
	}
	var bytes: u8[] = buffer.data
	bytes[index] = byte as u8
	value_write_null(out)
	ret 0
}

func eferra_stream_close(stream: EFerraStream*): i32 {
	if stream is null or stream.closed { ret 0 }
	if stream.kind is EFERRA_STREAM_FILE {
		if stream.handle not null { fclose(stream.handle) }
	} elif stream.kind is EFERRA_STREAM_HTTP {
		if stream.handle not null { http_stream_close(stream.handle) }
	}
	stream.handle = null
	stream.closed = true
	stream.done = true
	ret 0
}
func eferra_stream_drop(raw_stream: ptr): i32 {
	var stream: EFerraStream* = raw_stream
	if stream is null { ret 0 }
	eferra_stream_close(stream)
	free(stream)
	ret 0
}
func eferra_write_stream(
	out: Value*,
	module: Module*,
	kind: i32,
	handle: ptr
): bol {
	var stream: EFerraStream* = calloc(1, sizeof(EFerraStream))
	if stream is null { ret false }
	stream.kind = kind
	stream.handle = handle
	stream.buffer_native_type = (module^).buffer_native_type
	value_write_owned_native_object(
		out,
		(module^).stream_native_type,
		stream,
		eferra_stream_drop
	)
	ret true
}
func native_stream_read(
	receiver: ptr,
	raw_args: ptr,
	count: i32,
	raw_out: ptr
): i32 {
	var stream: EFerraStream* = receiver
	var args: Value[] = raw_args
	if stream is null or args[0].type not V_NATIVE_OBJECT or
			args[0].native_id not stream.buffer_native_type {
		log("Stream.read expects a Buffer")
		ret 1
	}
	var buffer: EFerraBuffer* = args[0].native_data
	buffer.size = 0
	var bytes: u8[] = buffer.data
	bytes[0] = 0
	if stream.closed or stream.done {
		value_write_num(raw_out, 0)
		ret 0
	}

	var read_size: i64 = 0
	if stream.kind is EFERRA_STREAM_FILE {
		read_size = fread(buffer.data, 1, buffer.capacity, stream.handle)
		if read_size is 0 {
			stream.done = true
			if ferror(stream.handle) not 0 { stream.read_error = true }
		}
	} elif stream.kind is EFERRA_STREAM_HTTP {
		read_size = http_stream_read(
			stream.handle,
			buffer.data,
			buffer.capacity as usize
		)
		if http_stream_done(stream.handle) { stream.done = true }
	} else {
		log("Stream.read has an invalid stream kind")
		ret 1
	}

	if read_size > 0 {
		buffer.size = read_size
		bytes[read_size] = 0
	}
	value_write_num(raw_out, read_size as f64)
	ret 0
}
func native_stream_done(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var stream: EFerraStream* = receiver
	if stream is null { ret 1 }
	var done: bol = stream.closed or stream.done
	if stream.kind is EFERRA_STREAM_HTTP and stream.closed is false {
		done = http_stream_done(stream.handle) not 0
		if done { stream.done = true }
	}
	value_write_num(out, done as f64)
	ret 0
}
func native_stream_close(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var stream: EFerraStream* = receiver
	if stream is null { ret 1 }
	eferra_stream_close(stream)
	value_write_null(out)
	ret 0
}
func native_stream_error(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var stream: EFerraStream* = receiver
	if stream is null { ret 1 }
	if stream.kind is EFERRA_STREAM_FILE {
		if stream.read_error { value_write_str(out, "file stream read failed") }
		else { value_write_null(out) }
	} elif stream.closed {
		value_write_null(out)
	} else {
		var message: str = http_stream_error(stream.handle)
		if message is null { value_write_null(out) }
		else { value_write_str(out, message) }
	}
	ret 0
}
func native_stream_status(receiver: ptr, args: ptr, count: i32, out: ptr): i32 {
	var stream: EFerraStream* = receiver
	if stream is null { ret 1 }
	var status: i64 = 0
	if stream.kind is EFERRA_STREAM_HTTP and stream.closed is false {
		status = http_stream_status(stream.handle)
	}
	value_write_num(out, status as f64)
	ret 0
}

func register_buffer_and_stream(module: Module*) {
	var buffer_type: i32 = (module^).add_native_type("Buffer")
	(module^).buffer_native_type = buffer_type
	(module^).add_native_method(buffer_type, "len", 0, native_buffer_len)
	(module^).add_native_method(buffer_type, "capacity", 0, native_buffer_capacity)
	(module^).add_native_method(buffer_type, "clear", 0, native_buffer_clear)
	(module^).add_native_method(buffer_type, "reserve", 1, native_buffer_reserve)
	(module^).add_native_method(buffer_type, "append", 1, native_buffer_append)
	(module^).add_native_method(buffer_type, "str", 0, native_buffer_str)
	(module^).add_native_method(buffer_type, "bytes", 0, native_buffer_bytes)
	(module^).add_native_method(buffer_type, "get", 1, native_buffer_get)
	(module^).add_native_method(buffer_type, "set", 2, native_buffer_set)

	var stream_type: i32 = (module^).add_native_type("Stream")
	(module^).stream_native_type = stream_type
	(module^).add_native_method(stream_type, "read", 1, native_stream_read)
	(module^).add_native_method(stream_type, "done", 0, native_stream_done)
	(module^).add_native_method(stream_type, "close", 0, native_stream_close)
	(module^).add_native_method(stream_type, "error", 0, native_stream_error)
	(module^).add_native_method(stream_type, "status", 0, native_stream_status)

	var runtime_type: i32 = (module^).add_native_type("BufferRuntime")
	(module^).add_native_method(runtime_type, "create", 1, native_buffer_create)
	(module^).add_native_method(runtime_type, "from", 1, native_buffer_from)
	var buffer_value: Value
	value_write_native_object(^buffer_value, runtime_type, module)
	(module^).add_native_global("buffer", buffer_value)
}

// file
func native_file_read(
	receiver: ptr,
	rargs: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var args: Value[] = rargs

	if args[0].type not V_STRING {
		log("file.read expects string")
		value_write_null(out)
		ret 1
	}

	var f: File()
	if f.open(args[0].text, MODE_READ_ONLY) is false {
		log("failed to open file")
		value_write_null(out)
		ret 1
	}
	var size: i64 = f.size()
	var s: str = calloc(size + 1, 1)
	if s is null {
		log("failed to allocate string needed for reading the file")
		value_write_null(out)
		ret 1
	}
	// allocate string with size needed for reading the file
	f.read(s)

	value_write_str(out, s)
	free(s)
	ret 0
}
func native_file_write(
	receiver: ptr,
	rargs: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var args: Value[] = rargs

	if args[0].type not V_STRING or args[1].type not V_STRING {
		log("file.write expects strings")
		value_write_null(out)
		ret 1
	}

	var f: File()
	if f.open(args[0].text, MODE_WRITE_ONLY) is false {
		log("failed to open file")
		value_write_null(out)
		ret 1
	}
	
	f.write(args[1].text)

	value_write_num(out, 1)
	ret 0
}
func native_file_fdir(
	receiver: ptr,
	rargs: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	value_write_str(out, env.get("FERRA_PATH"))
	ret 0
}
func native_file_dir(
	receiver: ptr,
	rargs: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	value_write_str(out, env.cwd())
	ret 0
}
func native_file_stream(
	receiver: ptr,
	raw_args: ptr,
	argument_count: i32,
	raw_out: ptr
): i32 {
	var module: Module* = receiver
	var args: Value[] = raw_args
	if module is null or args[0].type not V_STRING {
		log("file.stream expects a path string")
		ret 1
	}
	var handle: ptr = fopen(args[0].text, MODE_READ_BINARY)
	if handle is null { log("file.stream failed to open file"); ret 1 }
	if eferra_write_stream(raw_out, module, EFERRA_STREAM_FILE, handle) is false {
		fclose(handle)
		log("file.stream allocation failed")
		ret 1
	}
	ret 0
}
func native_file_mkdir(
	receiver: ptr,
	rargs: ptr,
	argument_count: i32,
	out: ptr
): i32 {
	var args: Value[] = rargs

	if args[0].type not V_STRING {
		log("file.mkdir expects string")
		ret 1
	}

	value_write_num(out, directory_create(args[0].text) as f64)
	
	ret 0
}
func register_file(module: Module*) {
	var file_type: i32 = (module^).find_native_type("File")
	if file_type < 0 { file_type = (module^).add_native_type("File") }

	if (module^).find_native_method(file_type, "read") < 0 {
		(module^).add_native_method(file_type, "read", 1, native_file_read)
	}
	if (module^).find_native_method(file_type, "write") < 0 {
		(module^).add_native_method(file_type, "write", 2, native_file_write)
	}
	if (module^).find_native_method(file_type, "dir") < 0 {
		(module^).add_native_method(file_type, "dir", 0, native_file_dir)
	}
	if (module^).find_native_method(file_type, "fdir") < 0 {
		(module^).add_native_method(file_type, "fdir", 0, native_file_fdir)
	}
	if (module^).find_native_method(file_type, "mkdir") < 0 {
		(module^).add_native_method(file_type, "mkdir", 1, native_file_mkdir)
	}
	if (module^).find_native_method(file_type, "stream") < 0 {
		(module^).add_native_method(file_type, "stream", 1, native_file_stream)
	}

	if (module^).find_native_global("file") < 0 {
		var file_value: Value
		value_write_native_object(^file_value, file_type, module)
		(module^).add_native_global("file", file_value)
	}
}

