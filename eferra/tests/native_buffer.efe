let chunk = buffer.create(4)
log(chunk.len())
log(chunk.capacity())
log(chunk.append("ab"))
log(chunk.append(255))
log(chunk.bytes())
log(chunk.get(1))
chunk.set(1, 90)
log(chunk.bytes())

chunk.clear()
log(chunk.append("hello"))
log(chunk.capacity())
log(chunk.str())

let suffix = buffer.from("!")
log(chunk.append(suffix))
log(chunk.str())

let binary = buffer.create(2)
binary.append(65)
binary.append(0)
binary.append(66)
log(binary.bytes())
log(binary.str())
