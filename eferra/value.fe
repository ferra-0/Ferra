const V_NULL: i8 = 0
const V_NUM: i8 = 1
const V_STRING: i8 = 2
const V_ARRAY: i8 = 3
const V_OBJECT: i8 = 4
const V_NATIVE_OBJECT: i8 = 5
const V_NATIVE_FUNCTION: i8 = 6
const V_FUNCTION: i8 = 7

__llh "define i32 @efe_native_drop_bridge(ptr %callback, ptr %data) { %result = call i32 %callback(ptr %data) ret i32 %result }"
extern func efe_native_drop_bridge(ptr, ptr): i32

extern func efe_native_call_bridge(ptr, ptr, ptr, i32, ptr): i32

var VALUE_NEXT_OBJECT_ID: i64 = 1

stct ValueRefs {
	count: i32,
	array_items: ptr,
	array_size: i32,
	array_capacity: i32,
	object_keys: str[],
	object_items: ptr,
	object_size: i32,
	object_capacity: i32,
	object_id: i64,
	native_data: ptr,
	native_drop: ptr,
	native_type: i32
}

stct Value {
	type: i8,

	num: f64,
	text: str,

	items: Value[],
	keys: str[],
	size: i32,
	refs: ValueRefs*,
	native_id: i32,
	native_data: ptr
}

stct BoundNativeContext {
	receiver: Value,
	vm: ptr,
	module: ptr
}

func value_refs_retain(refs: ValueRefs*) {
	if refs not null { atomic_add<i32>(^((refs^).count), 1) }
}

func value_refs_release(refs: ValueRefs*): bol {
	if refs is null { ret false }
	ret atomic_add<i32>(^((refs^).count), -1) <= 1
}

func value_next_object_id(): i64 {
	ret atomic_add<i64>(^VALUE_NEXT_OBJECT_ID, 1)
}

func value_release_native_refs(refs: ValueRefs*): bol {
	if refs is null { ret false }
	if value_refs_release(refs) {
		if (refs^).native_drop not null {
			efe_native_drop_bridge((refs^).native_drop, (refs^).native_data)
		}
		free(refs)
	}
	ret true
}

drop Value() {
	if this.type is V_STRING and this.text not null {
		if this.refs not null {
			if value_refs_release(this.refs) {
				free(this.text)
				free(this.refs)
			}
		} else {
			free(this.text)
		}
		this.text = null
		this.refs = null
	}

	if this.type is V_ARRAY and this.refs not null {
		if value_refs_release(this.refs) {
			var array_items: Value[] = (this.refs^).array_items
			var array_size: i32 = (this.refs^).array_size
			if array_items not null {
				for i in array_size {
					dropnow array_items[i]
				}
				free(array_items)
			}

			free(this.refs)
		}

		this.items = null
		this.keys = null
		this.refs = null
		this.size = 0
	}

	if this.type is V_OBJECT and this.refs not null {
		if value_refs_release(this.refs) {
			var keys: str[] = (this.refs^).object_keys
			var items: Value[] = (this.refs^).object_items
			var size: i32 = (this.refs^).object_size

			if keys not null {
				for i in size {
					if keys[i] not null { free(keys[i]) }
				}
				free(keys)
			}
			if items not null {
				for i in size { dropnow items[i] }
				free(items)
			}
			free(this.refs)
		}

		this.items = null
		this.keys = null
		this.refs = null
		this.size = 0
	}

	if (this.type is V_NATIVE_OBJECT or this.type is V_NATIVE_FUNCTION) and
			this.refs not null {
		value_release_native_refs(this.refs)
		this.refs = null
		this.native_data = null
		this.native_id = -1
	}
}



func value_release(value: Value*) {
	if value.type is V_STRING and value.text not null {
		var refs: ValueRefs* = value.refs;
		if refs not null {
			if value_refs_release(refs) {
				free(value.text)
				free(refs)
			}
		} else {
			free(value.text)
		}
	}

	if value.type is V_ARRAY and value.refs not null {
		var refs: ValueRefs* = value.refs;
		if value_refs_release(refs) {
			var array_items: Value[] = (refs^).array_items
			var array_size: i32 = (refs^).array_size
			if array_items not null {
				for i in array_size { dropnow array_items[i] }
				free(array_items)
			}
			free(refs)
		}
	}

	if value.type is V_OBJECT and value.refs not null {
		var refs: ValueRefs* = value.refs;
		if value_refs_release(refs) {
			var keys: str[] = (refs^).object_keys
			var items: Value[] = (refs^).object_items
			var size: i32 = (refs^).object_size
			if keys not null {
				for i in size {
					if keys[i] not null { free(keys[i]) }
				}
				free(keys)
			}
			if items not null {
				for i in size { dropnow items[i] }
				free(items)
			}
			free(refs)
		}
	}

	if (value.type is V_NATIVE_OBJECT or value.type is V_NATIVE_FUNCTION) and
			value.refs not null {
		value_release_native_refs(value.refs)
	}

	value.type = V_NULL
	value.num = 0
	value.text = null
	value.items = null
	value.keys = null
	value.size = 0
	value.refs = null
	value.native_id = -1
	value.native_data = null
}

func value_replace_num(out: Value*, number: f64) {
	if out.type is V_STRING or out.type is V_ARRAY or out.type is V_OBJECT or
			out.type is V_NATIVE_OBJECT or out.type is V_NATIVE_FUNCTION {
		value_release(out)
	}
	out.type = V_NUM
	out.num = number
}

func value_release_string(value: Value*) {
	var refs: ValueRefs* = value.refs
	if value.text not null {
		if refs not null {
			if value_refs_release(refs) {
				free(value.text)
				free(refs)
			}
		} else {
			free(value.text)
		}
	}
	value.type = V_NULL
	value.text = null
	value.refs = null
}

func value_assign(out: Value*, source: Value) {
	if source.type is V_NUM {
		value_replace_num(out, source.num)
	} elif source.type is V_NULL {
		if out.type is V_STRING or out.type is V_ARRAY or out.type is V_OBJECT or
				out.type is V_NATIVE_OBJECT or out.type is V_NATIVE_FUNCTION {
			value_release(out)
		} else {
			value_write_null(out)
		}
	} elif source.type is V_STRING {
		var text: str = source.text
		var refs: ValueRefs* = source.refs
		value_refs_retain(refs)
		if out.type is V_STRING {
			value_release_string(out)
		} elif out.type is V_ARRAY or out.type is V_OBJECT or
				out.type is V_NATIVE_OBJECT or out.type is V_NATIVE_FUNCTION {
			value_release(out)
		}
		if refs is null {
			value_write_str(out, text)
		} else {
			out.type = V_STRING
			out.text = text
			out.refs = refs
		}
	} elif source.type is V_ARRAY {
		var items: Value[] = value_array_items(source)
		var size: i32 = value_array_size(source)
		var refs: ValueRefs* = source.refs
		value_refs_retain(refs)
		if out.type is V_STRING or out.type is V_ARRAY or out.type is V_OBJECT or
				out.type is V_NATIVE_OBJECT or out.type is V_NATIVE_FUNCTION {
			value_release(out)
		}
		out.type = V_ARRAY
		out.items = items
		out.size = size
		out.refs = refs
	} elif source.type is V_OBJECT {
		var refs: ValueRefs* = source.refs
		var items: Value[] = null
		var keys: str[] = null
		var size: i32 = 0
		if refs not null {
			value_refs_retain(refs)
			items = (refs^).object_items
			keys = (refs^).object_keys
			size = (refs^).object_size
		}
		if out.type is V_STRING or out.type is V_ARRAY or out.type is V_OBJECT or
				out.type is V_NATIVE_OBJECT or out.type is V_NATIVE_FUNCTION {
			value_release(out)
		}
		out.type = V_OBJECT
		out.items = items
		out.keys = keys
		out.size = size
		out.refs = refs
	} elif source.type is V_NATIVE_OBJECT or source.type is V_NATIVE_FUNCTION {
		var refs: ValueRefs* = source.refs
		value_refs_retain(refs)
		if out.type is V_STRING or out.type is V_ARRAY or out.type is V_OBJECT or
				out.type is V_NATIVE_OBJECT or out.type is V_NATIVE_FUNCTION {
			value_release(out)
		}
		out.type = source.type
		out.native_id = source.native_id
		out.native_data = source.native_data
		out.refs = refs
	} elif source.type is V_FUNCTION {
		if out.type is V_STRING or out.type is V_ARRAY or out.type is V_OBJECT or
				out.type is V_NATIVE_OBJECT or out.type is V_NATIVE_FUNCTION {
			value_release(out)
		}
		value_write_function(out, source.native_id)
	} else {
		value_write_null(out)
	}
}

func value_null(): Value {
	var v: Value
	v.type = V_NULL
	ret v
}
func value_num(n: f64): Value {
	var v: Value

	v.type = V_NUM
	v.num = n

	ret v
}
func value_str(txt: str): Value {
	var v: Value
	var size: usize = strlen(txt)
	var copy: str = malloc(size + 1)
	var refs: ValueRefs* = malloc(sizeof(ValueRefs))

	if copy is null or refs is null {
		efe_error("string allocation failed")
		exit(1)
	}

	memcpy(copy, txt, size + 1)

	v.type = V_STRING
	v.text = copy
	(refs^).count = 1
	v.refs = refs

	ret v
}
func value_array(items: Value[], size: i32): Value {
  var value: Value
	var refs: ValueRefs* = calloc(1, sizeof(ValueRefs))

	if refs is null {
		efe_error("array reference counter allocation failed")
		exit(1)
	}

	(refs^).count = 1
	(refs^).array_items = items
	(refs^).array_size = size
	(refs^).array_capacity = size

  value.type = V_ARRAY
  value.items = items
  value.size = size
	value.refs = refs

  ret value
}

func value_write_null(out: Value*) {
	(out^).type = V_NULL
	(out^).num = 0
	(out^).text = null
	(out^).items = null
	(out^).keys = null
	(out^).size = 0
	(out^).refs = null
	(out^).native_id = -1
	(out^).native_data = null
}

func value_write_num(out: Value*, number: f64) {
	value_write_null(out)
	(out^).type = V_NUM
	(out^).num = number
}

func value_write_function(out: Value*, function_id: i32) {
	value_write_null(out)
	(out^).type = V_FUNCTION
	(out^).native_id = function_id
}

func value_write_str(out: Value*, text: str) {
	value_write_null(out)
	var size: usize = strlen(text)
	var copy: str = malloc(size + 1)
	var refs: ValueRefs* = malloc(sizeof(ValueRefs))
	if copy is null or refs is null {
		efe_error("string allocation failed")
		exit(1)
	}
	memcpy(copy, text, size + 1)
	(out^).type = V_STRING
	(out^).text = copy
	(refs^).count = 1
	(out^).refs = refs
}

func value_write_array(out: Value*, items: Value[], size: i32) {
	value_write_null(out)
	var refs: ValueRefs* = calloc(1, sizeof(ValueRefs))
	if refs is null {
		efe_error("array reference counter allocation failed")
		exit(1)
	}
	(refs^).count = 1
	(refs^).array_items = items
	(refs^).array_size = size
	(refs^).array_capacity = size
	(out^).type = V_ARRAY
	(out^).items = items
	(out^).size = size
	(out^).refs = refs
}

func value_write_object(out: Value*, keys: str[], items: Value[], size: i32) {
	value_write_null(out)
	var refs: ValueRefs* = malloc(sizeof(ValueRefs))
	if refs is null {
		efe_error("object reference counter allocation failed")
		exit(1)
	}
	(refs^).count = 1
	(refs^).object_keys = keys
	(refs^).object_items = items
	(refs^).object_size = size
	(refs^).object_capacity = size
	(refs^).object_id = value_next_object_id()
	(out^).type = V_OBJECT
	(out^).keys = keys
	(out^).items = items
	(out^).size = size
	(out^).refs = refs
}



func value_write_native_object(out: Value*, native_type: i32, data: ptr) {
	value_write_null(out)
	(out^).type = V_NATIVE_OBJECT
	(out^).native_id = native_type
	(out^).native_data = data
}



func value_write_owned_native_object(
	out: Value*,
	native_type: i32,
	data: ptr,
	drop_callback: func
) {
	value_write_null(out)
	var refs: ValueRefs* = calloc(1, sizeof(ValueRefs))
	if refs is null {
		efe_error("native object reference counter allocation failed")
		exit(1)
	}
	(refs^).count = 1
	(refs^).native_data = data
	(refs^).native_drop = drop_callback
	(refs^).native_type = native_type
	(out^).type = V_NATIVE_OBJECT
	(out^).native_id = native_type
	(out^).native_data = data
	(out^).refs = refs
}

func value_write_native_function(
	out: Value*,
	function_id: i32,
	receiver: ptr,
	receiver_refs: ValueRefs*
) {
	value_write_null(out)
	(out^).type = V_NATIVE_FUNCTION
	(out^).native_id = function_id
	(out^).native_data = receiver
	(out^).refs = receiver_refs
	value_refs_retain(receiver_refs)
}

func value_clone_into(value: Value, out: Value*) {
	if value.type is V_NULL {
		value_write_null(out)
	} elif value.type is V_NUM {
		value_write_num(out, value.num)
	} elif value.type is V_STRING {
		if value.refs is null {
			value_write_str(out, value.text)
		} else {
			var string_refs: ValueRefs* = value.refs
			value_write_null(out);
			(out^).type = V_STRING;
			(out^).text = value.text;
			(out^).refs = string_refs;
			value_refs_retain(string_refs)
		}
	} elif value.type is V_ARRAY {
		value_write_null(out)
		var items: Value[] = value_array_items(value);
		(out^).type = V_ARRAY;
		(out^).items = items;
		(out^).size = value_array_size(value);
		(out^).refs = value.refs;
		var refs: ValueRefs* = (out^).refs
		value_refs_retain(refs)
	} elif value.type is V_OBJECT {
		value_write_null(out)
		(out^).type = V_OBJECT;
		(out^).refs = value.refs;
		var refs: ValueRefs* = (out^).refs
		if refs not null {
			var items: Value[] = (refs^).object_items;
			(out^).items = items;
			(out^).keys = (refs^).object_keys;
			(out^).size = (refs^).object_size;
			value_refs_retain(refs)
		}
	} elif value.type is V_NATIVE_OBJECT or value.type is V_NATIVE_FUNCTION {
		value_write_null(out)
		(out^).type = value.type;
		(out^).native_id = value.native_id;
		(out^).native_data = value.native_data;
		(out^).refs = value.refs;
		var native_refs: ValueRefs* = (out^).refs
		value_refs_retain(native_refs)
	} elif value.type is V_FUNCTION {
		value_write_function(out, value.native_id)
	} else {
		value_write_null(out)
	}
}

func value_clone(value: Value): Value {
	if value.type is V_NULL {
		ret value_null()
	}
	if value.type is V_NUM {
		ret value_num(value.num)
	}
	if value.type is V_STRING {
		if value.refs is null { ret value_str(value.text) }
		var clone: Value
		var string_refs: ValueRefs* = value.refs
		clone.type = V_STRING
		clone.text = value.text
		clone.refs = string_refs
		value_refs_retain(clone.refs)
		ret clone
	}
	if value.type is V_ARRAY {
		var clone: Value
		var items: Value[] = value_array_items(value)
		clone.type = V_ARRAY
		clone.items = items
		clone.size = value_array_size(value)
		clone.refs = value.refs

		value_refs_retain(clone.refs)

		ret clone
	}
	if value.type is V_OBJECT {
		var clone: Value
		var object_items: Value[] = null
		var object_keys: str[] = null
		var object_size: i32 = 0
		if value.refs not null {
			object_items = (value.refs^).object_items
			object_keys = (value.refs^).object_keys
			object_size = (value.refs^).object_size
		}
		clone.type = V_OBJECT
		clone.keys = object_keys
		clone.items = object_items
		clone.size = object_size
		clone.refs = value.refs

		value_refs_retain(clone.refs)

		ret clone
	}
	if value.type is V_NATIVE_OBJECT or value.type is V_NATIVE_FUNCTION {
		var clone: Value
		value_write_null(^clone)
		clone.type = value.type
		clone.native_id = value.native_id
		clone.native_data = value.native_data
		clone.refs = value.refs
		value_refs_retain(clone.refs)
		ret clone
	}
	if value.type is V_FUNCTION {
		var clone: Value
		value_write_function(^clone, value.native_id)
		ret clone
	}

	ret value_null()
}



func value_bound_receiver_drop(data: ptr): i32 {
	var context: BoundNativeContext* = data
	if context not null {
		value_release(^(context.receiver))
		free(context)
	}
	ret 0
}

func value_write_bound_native_function(
	out: Value*,
	function_id: i32,
	receiver_value: Value,
	vm: ptr,
	module: ptr
) {
	var context: BoundNativeContext* = malloc(sizeof(BoundNativeContext))
	var refs: ValueRefs* = calloc(1, sizeof(ValueRefs))
	if context is null or refs is null {
		efe_error("bound method allocation failed")
		exit(1)
	}
	value_write_null(^(context.receiver))
	value_clone_into(receiver_value, ^(context.receiver))
	context.vm = vm
	context.module = module
	(refs^).count = 1
	(refs^).native_data = context
	(refs^).native_drop = value_bound_receiver_drop

	value_write_null(out)
	(out^).type = V_NATIVE_FUNCTION
	(out^).native_id = function_id
	(out^).native_data = context
	(out^).refs = refs
}

func value_object_find(object: Value, key: str): i32 {
	if object.type not V_OBJECT or object.refs is null { ret -1 }
	var keys: str[] = (object.refs^).object_keys
	for i in (object.refs^).object_size {
		if strcmp(keys[i], key) is 0 { ret i }
	}
	ret -1
}

func value_array_size(array: Value): i32 {
	if array.type not V_ARRAY or array.refs is null { ret 0 }
	ret (array.refs^).array_size
}

func value_array_items(array: Value): Value[] {
	if array.type not V_ARRAY or array.refs is null {
		var empty: Value[] = null
		ret empty
	}
	var items: Value[] = (array.refs^).array_items
	ret items
}

func value_array_reserve(array: Value*, requested: i32): bol {
	if array.type not V_ARRAY or array.refs is null { ret false }
	var refs: ValueRefs* = array.refs
	if requested <= (refs^).array_capacity { ret true }

	var capacity: i32 = (refs^).array_capacity
	if capacity < 4 { capacity = 4 }
	for capacity < requested { capacity *= 2 }

	var grown: Value[] = calloc(capacity, sizeof(Value))
	if grown is null { ret false }
	var old: Value[] = (refs^).array_items
	for i in (refs^).array_size {
		value_clone_into(old[i], ^(grown[i]))
		dropnow old[i]
	}
	if old not null { free(old) }
	(refs^).array_items = grown
	(refs^).array_capacity = capacity
	array.items = grown
	ret true
}

func value_array_push(array: Value*, value: Value): bol {
	if array.type not V_ARRAY or array.refs is null { ret false }
	var refs: ValueRefs* = array.refs
	var next_size: i32 = (refs^).array_size + 1
	if value_array_reserve(array, next_size) is false { ret false }
	var items: Value[] = (refs^).array_items
	value_clone_into(value, ^(items[(refs^).array_size]))
	(refs^).array_size = next_size
	array.size = next_size
	ret true
}

func value_array_pop(array: Value*, out: Value*): bol {
	if array.type not V_ARRAY or array.refs is null or
			(array.refs^).array_size <= 0 { ret false }
	var refs: ValueRefs* = array.refs
	var index: i32 = (refs^).array_size - 1
	var items: Value[] = (refs^).array_items
	value_assign(out, items[index])
	dropnow items[index]
	(refs^).array_size = index
	array.size = index
	ret true
}

func value_object_size(object: Value): i32 {
	if object.type not V_OBJECT or object.refs is null { ret 0 }
	ret (object.refs^).object_size
}

func value_object_items(object: Value): Value[] {
	if object.type not V_OBJECT or object.refs is null {
		var empty: Value[] = null
		ret empty
	}
	var items: Value[] = (object.refs^).object_items
	ret items
}

func value_object_set(object: Value*, key: str, value: Value): i32 {
	if object.type not V_OBJECT or object.refs is null {
		efe_error("runtime error: field assignment on a non-object value")
		exit(1)
	}

	var refs: ValueRefs* = object.refs
	var index: i32 = value_object_find(object^, key)
	var items: Value[] = (refs^).object_items
	if index >= 0 {
		dropnow items[index]
		value_clone_into(value, ^(items[index]))
	} else {
	if (refs^).object_size >= (refs^).object_capacity {
		var new_capacity: i32 = (refs^).object_capacity * 2
		if new_capacity < 4 { new_capacity = 4 }

		var new_keys: str[] = calloc(new_capacity, sizeof(str))
		var new_items: Value[] = calloc(new_capacity, sizeof(Value))
		if new_keys is null or new_items is null {
			efe_error("runtime error: object growth allocation failed")
			exit(1)
		}

		var old_keys: str[] = (refs^).object_keys
		var old_items: Value[] = (refs^).object_items
		for i in (refs^).object_size {
			new_keys[i] = old_keys[i]
			value_clone_into(old_items[i], ^(new_items[i]))
			dropnow old_items[i]
		}
		if old_keys not null { free(old_keys) }
		if old_items not null { free(old_items) }

		(refs^).object_keys = new_keys
		(refs^).object_items = new_items
		(refs^).object_capacity = new_capacity
		items = new_items
	}

	index = (refs^).object_size
	var key_size: usize = strlen(key)
	var key_copy: str = malloc(key_size + 1)
	if key_copy is null {
		efe_error("runtime error: object key allocation failed")
		exit(1)
	}
	memcpy(key_copy, key, key_size + 1)
	(refs^).object_keys[index] = key_copy
	value_clone_into(value, ^(items[index]))
	(refs^).object_size += 1
	(refs^).object_id = value_next_object_id()
	}
	ret index
}

func value_object_remove(object: Value*, key: str, out: Value*): bol {
	if object.type not V_OBJECT or object.refs is null { ret false }
	var refs: ValueRefs* = object.refs
	var index: i32 = value_object_find(object^, key)
	if index < 0 { ret false }

	var keys: str[] = (refs^).object_keys
	var items: Value[] = (refs^).object_items
	value_assign(out, items[index])
	if keys[index] not null { free(keys[index]) }
	dropnow items[index]

	var i: i32 = index
	for i < (refs^).object_size - 1 {
		keys[i] = keys[i + 1]
		value_clone_into(items[i + 1], ^(items[i]))
		dropnow items[i + 1]
		i += 1
	}
	var last: i32 = (refs^).object_size - 1
	keys[last] = null
	(refs^).object_size = last
	(refs^).object_id = value_next_object_id()
	object.size = last
	ret true
}

func value_equal(a: Value, b: Value): bol {
	if a.type not b.type {
		ret false
	}
	if a.type is V_NULL {
		ret true
	}
	if a.type is V_NUM {
		ret a.num is b.num
	}
	if a.type is V_STRING {
		ret strcmp(a.text, b.text) is 0
	}
	if a.type is V_ARRAY {
		var a_size: i32 = value_array_size(a)
		if a_size not value_array_size(b) {
			ret false
		}
		var a_items: Value[] = value_array_items(a)
		var b_items: Value[] = value_array_items(b)
		for i in a_size {
			if value_equal(a_items[i], b_items[i]) is false {
				ret false
			}
		}

		ret true
	}
	if a.type is V_OBJECT {
		var a_size: i32 = value_object_size(a)
		if a_size not value_object_size(b) { ret false }
		var a_keys: str[] = (a.refs^).object_keys
		var a_items: Value[] = (a.refs^).object_items
		var b_items: Value[] = (b.refs^).object_items

		for i in a_size {
			var other: i32 = value_object_find(b, a_keys[i])
			if other < 0 or value_equal(a_items[i], b_items[other]) is false {
				ret false
			}
		}

		ret true
	}
	if a.type is V_NATIVE_OBJECT or a.type is V_NATIVE_FUNCTION {
		ret a.native_id is b.native_id and a.native_data is b.native_data
	}
	if a.type is V_FUNCTION { ret a.native_id is b.native_id }

	ret false
}

func value_truthy(value: Value): bol {
	if value.type is V_NULL { ret false }
	if value.type is V_NUM { ret value.num not 0 }
	if value.type is V_STRING { ret value.text not null and value.text[0] not 0 }
	if value.type is V_ARRAY { ret value_array_size(value) > 0 }
	if value.type is V_OBJECT { ret value_object_size(value) > 0 }
	if value.type is V_NATIVE_OBJECT or value.type is V_NATIVE_FUNCTION {
		ret true
	}
	if value.type is V_FUNCTION { ret true }
	ret false
}

func print_value(v: Value) {
	if v.type is V_NULL {
		logl("null")
	} elif v.type is V_NUM {
		logl(v.num)
	} elif v.type is V_STRING {
		logl(v.text)
	} elif v.type is V_ARRAY {
		var size: i32 = value_array_size(v)
		var items: Value[] = value_array_items(v)
		logl("[")
		for i in size {
			if i > 0 { logl(", ") }
			print_value(items[i])
		}
		logl("]")
	} elif v.type is V_OBJECT {
		var size: i32 = value_object_size(v)
		var keys: str[] = (v.refs^).object_keys
		var items: Value[] = (v.refs^).object_items
		logl("{")
		for i in size {
			if i > 0 { logl(", ") }
			logl(keys[i])
			logl(": ")
			print_value(items[i])
		}
		logl("}")
	} elif v.type is V_NATIVE_OBJECT {
		logl("<FerraObject>")
	} elif v.type is V_NATIVE_FUNCTION {
		logl("<FerraFunction>")
	} elif v.type is V_FUNCTION {
		logl("<Function>")
	} else {
		logl("undefined")
	}
}
