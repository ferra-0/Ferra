#!/usr/bin/env sh
set -eu

SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH=$(dirname "$SCRIPT_PATH")/$LINK_TARGET ;;
  esac
done

BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
FERRA_ROOT=$(CDPATH= cd -- "$BIN_DIR/../share/ferra" && pwd)
export FERRA_PATH="$FERRA_ROOT"

exec "$BIN_DIR/efe" "$FERRA_ROOT/ferralang/iron.efe" "$@"
