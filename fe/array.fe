func contains<T>(v: T, a: T[], s: i64): bol{
  for i in s {
    if a[i] is v { ret true }
  }
  ret false
}
func indexof<T>(v: T, a: T[], s: i64): i64{
  for i in s {
    if a[i] is v { ret i }
  }
  ret -1
}
func reverse<T>(a: T[], s: i64, r: T[]): nul {
  var i: i64 = s - 1
  var ir: i64 = 0

  for i > -1 {
    r[ir] = a[i]

    i = i - 1
    ir = ir + 1
  }
}
func fill<T>(v: T, a: T[], c: i64): nul{
  for i in c {
    a[i] = v
  }
}
func copy<T>(a: T[], d: T[], s: i64): nul {
  for i in s {
    d[i] = a[i]
  }
}
func sort<T>(a: T[], n: i64): nul {
  var i: i64 = 0

  for i < n {
    var j: i64 = 0

    for j < n - i - 1 {
      if a[j] > a[j + 1] {
        var t: T = a[j]
        a[j] = a[j + 1]
        a[j + 1] = t
      }

      j = j + 1
    }

    i = i + 1
  }
}
func sortword(a: str[], n: i64): nul {
  var i: i64 = 0

  for i < n {
    var j: i64 = 0

    for j < n - i - 1 {
      if a[j] as i8 > a[j + 1] as i8 {
        var t: str = a[j]
        a[j] = a[j + 1]
        a[j + 1] = t
      }

      j = j + 1
    }

    i = i + 1
  }
}
