extern fn getenv(str): str
extern fn setenv(str, str, i32): i32
extern fn unsetenv(str): i32
extern fn getcwd(ptr, i64): ptr
extern fn _putenv_s(str, str): i32
extern fn SetEnvironmentVariableA(str, str): i32
extern fn GetCurrentDirectoryA(i32, ptr): i32

stct Env {}

impl Env get(p: str): str {
  ret getenv(p)
}
impl Env set(p: str, v: str): bol {
  if platform() is "linux" or platform() is "macos" {
    ret setenv(p, v, 1) is 0
  }
  if platform() is "windows" {
    ret _putenv_s(p, v) is 0
  }
}
impl Env unset(p: str): bol {
  if platform() is "linux" or platform() is "macos" {
    ret unsetenv(p) is 0
  }
  if platform() is "windows" {
    ret SetEnvironmentVariableA(p, null) not 0
  }
}
impl Env cwd(): str {
  let c[260]: i8

  if platform() is "linux" or platform() is "macos" {
    if getcwd(c, sizeof(c)) not null {
      ret c as str
    } else {
      free(c)
      ret null
    }
  }
  if platform() is "windows" {
    let r: i32 = GetCurrentDirectoryA(260, c)

    if r is 0 or r > 260 {
      free(c)
      ret null
    }

    ret c as str
  }
}

const env: Env
